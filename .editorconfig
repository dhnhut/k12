# Editor-level settings that apply before Prettier runs, and in editors without the Prettier extension:

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false   # two trailing spaces = hard line break

[*.py]
indent_size = 4                    # PEP 8, for services/agents later
